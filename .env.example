# Mission St. Louis Dashboard - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# SUPABASE CONFIGURATION (Required)
# ============================================
# Get these from: https://app.supabase.com/ → Your Project → Settings → API

# Your Supabase project URL
# Example: https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=your_supabase_project_url_here

# Your Supabase anonymous/public key (anon key)
# This is safe to expose in client-side code
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Application Environment
# Options: development | staging | production
# Default: development
NODE_ENV=development

# GitHub Pages Base Path
# If deploying to: https://username.github.io/repo-name/
# Set to: /repo-name/
# If deploying to: https://username.github.io/
# Set to: /
GITHUB_PAGES_BASE=/

# ============================================
# SECURITY NOTES
# ============================================
# - NEVER commit the .env file to version control
# - The .env file is in .gitignore by default
# - In GitHub Actions, add these as Repository Secrets:
#   Settings → Secrets and variables → Actions → New repository secret
# - The SUPABASE_ANON_KEY is meant to be public (it's row-level security protected)
# - Still, treat it with care and rotate if exposed unnecessarily

# ============================================
# TROUBLESHOOTING
# ============================================
# If you see "Missing Supabase environment variables" error:
# 1. Make sure you created .env file (copy from .env.example)
# 2. Verify VITE_SUPABASE_URL starts with https://
# 3. Verify VITE_SUPABASE_ANON_KEY is the full key (starts with eyJ)
# 4. No quotes needed around values
# 5. No trailing spaces
# 6. Restart dev server after changing .env: npm run dev
